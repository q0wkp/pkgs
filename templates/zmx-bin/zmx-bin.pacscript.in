pkgname="zmx-bin"
gives="zmx"
pkgver="@@PKGVER@@"
pkgdesc="Session persistence for terminal processes (fork with --min-window and session info)"
url="https://github.com/lutianyu2001/ZZZ_FORKED.zmx"
arch=('amd64' 'arm64')
maintainer=("q0wkp <q0wkp@users.noreply.github.com>")
source_amd64=("${url}/releases/download/@@TAG@@/zmx-@@VERSION@@-linux-x86_64.tar.gz")
source_arm64=("${url}/releases/download/@@TAG@@/zmx-@@VERSION@@-linux-aarch64.tar.gz")
sha256sums_amd64=("@@SHA256_X86_64@@")
sha256sums_arm64=("@@SHA256_AARCH64@@")

package() {
  install -Dm755 "${srcdir}/zmx" -t "${pkgdir}/usr/bin"
}
